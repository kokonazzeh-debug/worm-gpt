# REQUIRED: create a Hugging Face fine-grained token with Inference Providers permission.
HF_TOKEN=hf_put_your_token_here

# Port for local development.
PORT=8787

# Optional: comma-separated GitHub Pages origins. Example:
# FRONTEND_ORIGINS=https://YOUR-USERNAME.github.io,https://YOUR-CUSTOM-DOMAIN.com
FRONTEND_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
